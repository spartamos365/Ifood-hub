# Copie este arquivo para ".env" e preencha os valores.

# Porta em que o servidor vai rodar
PORT=3001

# Qual motor de IA o agente usa: "gemini" (gratuito, padrão), "groq" (gratuito,
# alternativa) ou "anthropic" (pago, precisa de créditos, melhor qualidade).
AI_PROVIDER=gemini

# --- Google Gemini (gratuito) ------------------------------------------
# Crie/entre com uma conta Google em https://aistudio.google.com e gere uma
# API key em https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (gratuito, alternativa) --------------------------------------
# Crie uma conta grátis (sem cartão) em https://console.groq.com e gere uma
# API key em https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic (pago, opcional — só necessário se AI_PROVIDER=anthropic) ---
# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Busca na web (opcional, gratuita) -----------------------------------
# Sem isso, o agente avisa que não tem dados atuais de mercado/notícias ao
# analisar oportunidades de negócio. Com isso, ele pesquisa de verdade antes
# de opinar. Crie uma conta grátis (sem cartão) em https://tavily.com e gere
# uma API key no dashboard. Tier gratuito: 1000 créditos/mês.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Login do assistente (uso pessoal, single-user)
ASSISTANT_EMAIL=voce@exemplo.com
ASSISTANT_PASSWORD=troque-esta-senha

# Nome usado pelo agente para se referir a voce
USER_NAME=Emerson

# Segredo usado para assinar os tokens JWT (gere uma string aleatoria longa)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Fuso horario usado para a rotina diaria / briefing matinal
TIMEZONE=America/Sao_Paulo
