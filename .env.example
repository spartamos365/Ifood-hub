# Copie este arquivo para ".env" e preencha os valores.

# Porta em que o servidor vai rodar
PORT=3001

# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo usado pelo agente
ANTHROPIC_MODEL=claude-sonnet-5

# Login do assistente (uso pessoal, single-user)
ASSISTANT_EMAIL=voce@exemplo.com
ASSISTANT_PASSWORD=troque-esta-senha

# Nome usado pelo agente para se referir a voce
USER_NAME=Emerson

# Segredo usado para assinar os tokens JWT (gere uma string aleatoria longa)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Fuso horario usado para a rotina diaria / briefing matinal
TIMEZONE=America/Sao_Paulo
